# Copy to mailer/.env. Never commit the real file.
MAILER_PORT=8091
CSM_MAILER_SECRET=replace-with-a-random-64-character-secret
APP_BASE_URL=http://127.0.0.1:8080
NODE_ENV=development
MAILER_TRANSPORT=smtp

# SMTP_SECURITY is implicit (SMTPS), starttls (recommended for port 587), or none (local testing only).
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Co-StudyMaxx <replace-with-sender@example.com>
